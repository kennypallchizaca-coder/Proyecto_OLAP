# ========================================================================
# SCRIPT: Recuperacion Point-in-Time
# ========================================================================
# Escenario: Recuperar base de datos a un momento especifico
# Ejemplo: Recuperar a 2025-12-30 10:00:00
# MODIFICAR LA FECHA SEGUN NECESIDAD
# ========================================================================


RUN {
    # Cerrar base de datos
    SHUTDOWN IMMEDIATE;
    
    # Iniciar en modo MOUNT
    STARTUP MOUNT;
    
    # Especificar punto en el tiempo (MODIFICAR SEGUN NECESIDAD)
    SET UNTIL TIME "TO_DATE('2026-01-07 21:17:09', 'YYYY-MM-DD HH24:MI:SS')";
    
    # Restaurar datafiles
    RESTORE DATABASE;
    
    # Recuperar hasta el punto especificado
    RECOVER DATABASE;
    
    # Abrir base de datos
    ALTER DATABASE OPEN RESETLOGS;
}


# Validar recuperacion exitosa
SQL 'SELECT name, open_mode, log_mode FROM v$database';

EXIT;
