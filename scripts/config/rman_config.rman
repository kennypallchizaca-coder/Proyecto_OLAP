# ========================================================================
# SCRIPT: Configuración Inicial de RMAN
# ========================================================================
# Proyecto: Plan de Recuperación - Comisariato
# Propósito: Configurar políticas y parámetros de RMAN
# Autor: DBA Senior
# Fecha: Diciembre 2025
# ========================================================================

CONNECT TARGET /

# Configurar ubicación de backups
CONFIGURE CONTROLFILE AUTOBACKUP ON;
CONFIGURE CONTROLFILE AUTOBACKUP FORMAT FOR DEVICE TYPE DISK TO 'C:\oracle\backup\rman\COMISARIATO_CF_%F';

# Configurar paralelismo (ajustar según CPUs disponibles)
CONFIGURE DEVICE TYPE DISK PARALLELISM 2;

# Configurar retention policy (7 días)
CONFIGURE RETENTION POLICY TO RECOVERY WINDOW OF 7 DAYS;

# Habilitar compresión para ahorrar espacio
CONFIGURE COMPRESSION ALGORITHM 'MEDIUM';

# Optimizar backups
CONFIGURE BACKUP OPTIMIZATION ON;

# Excluir tablespaces temporales (no necesitan backup)
CONFIGURE EXCLUDE FOR TABLESPACE TEMP;
CONFIGURE EXCLUDE FOR TABLESPACE TEMP01;

# Configurar formato de nombres de archivo
CONFIGURE CHANNEL DEVICE TYPE DISK FORMAT 'C:\oracle\backup\rman\COMISARIATO_%U';

# Mostrar configuración actual
SHOW ALL;

EXIT;
